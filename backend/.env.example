# Identidad de este banco (acordada con el BCP simulado y los otros grupos)
BANCO_ID=SUDAMERIS

# Puerto donde escucha el backend
PORT=8080

# Conexión a CockroachDB que usa el BACKEND (driver pgx). Lleva el esquema
# "postgresql://" porque pgx habla el protocolo de Postgres.
DATABASE_URL=postgresql://root@localhost:26257/sudameris?sslmode=disable

# Conexión que usa golang-migrate para correr las migraciones. Lleva el
# esquema "cockroachdb://" (no "postgresql://") porque el driver "postgres"
# de golang-migrate usa pg_advisory_lock(), una función que CockroachDB no
# implementa; el driver "cockroachdb" resuelve el locking de otra forma.
# Misma base, mismo puerto, solo cambia el esquema.
MIGRATE_DATABASE_URL=cockroachdb://root@localhost:26257/sudameris?sslmode=disable

# Clave privada Ed25519 de este banco, en base64 (NUNCA subir el valor real al repo).
# Generarla con:
#   openssl genpkey -algorithm Ed25519 -out privada.pem
#   openssl pkey -in privada.pem -pubout -out publica.pem
# Los .pem de arriba guardan la clave en formato PEM/DER, pero esta
# variable espera los 32 bytes crudos de la clave (el "seed"), en base64 --
# no el PEM entero. Para sacarlos del DER: el DER de una clave privada
# Ed25519 generada así siempre termina en esos 32 bytes, así que alcanza
# con quedarse con los últimos 32 bytes del DER y pasarlos a base64:
#   openssl pkey -in privada.pem -outform DER | tail -c 32 | base64
# Esa es la línea que va en BANCO_PRIVATE_KEY. Lo mismo sirve para sacar la
# clave pública en base64 (lo que pide registro_bancos.json como
# "clave_publica" para este banco), cambiando el archivo de entrada:
#   openssl pkey -pubin -in publica.pem -outform DER | tail -c 32 | base64
BANCO_PRIVATE_KEY=

# Ruta a un JSON con los datos de los otros bancos, en el formato oficial
# que distribuye el BCP simulado (documento 06, 06_registro_bancos_v2.json):
#   {
#     "bancos": [
#       {"banco_id": "BCO1", "url_base": "http://...", "clave_publica": "base64..."},
#       ...
#     ]
#   }
# Una entrada sin completar (url_base o clave_publica vacíos, o con el
# placeholder "<...>" del template) se ignora sin hacer fallar la carga.
# Mientras esté vacío: no se puede verificar firmas entrantes (todo
# /interbancario/* responde BANCO_NO_RECONOCIDO) ni hay a quién llamar
# (la ruta /transferencias/interbancarias ni se registra).
REGISTRO_BANCOS_PATH=


BCO_TEST_PRIVATE_KEY=
TEST_DATABASE_URL=postgresql://root@localhost:26257/sudameris_test?sslmode=disable

# Secreto que protege /cuentas (POST) y /cuentas/:numero_cuenta/estado
# (PATCH): son operaciones de back office del propio banco (alta y
# bloqueo/cierre de cuentas), no parte del contrato entre bancos ni de
# banca personal, así que no llevan firma ni sesión -- requieren este
# header en su lugar: X-Admin-Key: <el mismo valor de acá abajo>.
# Generar un valor random, por ejemplo con:
#   openssl rand -base64 32
# Si queda vacío, esas dos rutas responden 503 a cualquier request (ver
# handlers.RequireAdminKey): es fail-closed a propósito, para no quedar
# abiertas por olvido.
ADMIN_API_KEY=

# Lo mismo que ADMIN_API_KEY pero para el segundo backend de prueba
# (backend-bco-test, perfil "testing" de docker-compose.yml).
BCO_TEST_ADMIN_API_KEY=

# Orígenes permitidos para que el frontend (puerto distinto al de este
# backend) pueda llamar a la API desde el navegador sin que CORS lo
# bloquee. Separados por coma si hace falta más de uno. Vacío por
# defecto: sin esto, ningún navegador puede llamar a esta API (ver
# handlers.CORS).
# Ejemplo: CORS_ALLOWED_ORIGINS=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500
