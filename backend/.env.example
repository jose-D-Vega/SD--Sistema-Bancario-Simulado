# Identidad de este banco (acordada con el BCP simulado y los otros grupos)
BANCO_ID=SUDAMERIS

# Puerto donde escucha el backend
PORT=8080

# Conexión a CockroachDB que usa el BACKEND (driver pgx). Lleva el esquema
# "postgresql://" porque pgx habla el protocolo de Postgres.
DATABASE_URL=postgresql://root@localhost:26257/sudameris?sslmode=disable

# Conexión que usa golang-migrate para correr las migraciones. Lleva el
# esquema "cockroachdb://" (no "postgresql://") porque el driver "postgres"
# de golang-migrate usa pg_advisory_lock(), una función que CockroachDB no
# implementa; el driver "cockroachdb" resuelve el locking de otra forma.
# Misma base, mismo puerto, solo cambia el esquema.
MIGRATE_DATABASE_URL=cockroachdb://root@localhost:26257/sudameris?sslmode=disable

# Clave privada Ed25519 de este banco, en base64 (NUNCA subir el valor real al repo).
# Generarla con:
#   openssl genpkey -algorithm Ed25519 -out privada.pem
#   openssl pkey -in privada.pem -pubout -out publica.pem
# y convertir a base64 crudo (sin el formato PEM) para esta variable.
BANCO_PRIVATE_KEY=

BANCO_PUBLIC_KEY=ZsBaknXrh2+J1UbR3nJAGLEah1YfLwXb6qIklkRo9Lc=